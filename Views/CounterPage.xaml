<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Counter.Models"
             x:Class="Counter.Views.CounterPage"
             Title="Licznik"
             BackgroundColor="#F2F2F2"
             x:DataType="models:CounterItem">

    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <Label
            Text="{Binding Name}"
            FontSize="30"
            FontAttributes="Bold"
            TextColor="Black"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding Value}"
            FontSize="64"
            FontAttributes="Bold"
            TextColor="Black"
            HorizontalOptions="Center" />

        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">

            <Button
                Text="+"
                FontSize="30"
                WidthRequest="100"
                HeightRequest="60"
                BackgroundColor="Green"
                TextColor="White"
                Clicked="OnPlusClicked" />

            <Button
                Text="-"
                FontSize="30"
                WidthRequest="100"
                HeightRequest="60"
                BackgroundColor="Red"
                TextColor="White"
                Clicked="OnMinusClicked" />

        </HorizontalStackLayout>

        <Button
            Text="Powrot do listy"
            BackgroundColor="Gray"
            TextColor="White"
            Clicked="OnBackClicked" />

    </VerticalStackLayout>

</ContentPage>